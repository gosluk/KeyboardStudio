{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeyboardStudio keyboard template",
  "description": "Versioned physical keyboard identity and geometry contract. Project-specific mappings are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "unitWidth",
    "unitGap",
    "keys"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "unitWidth": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "unitGap": {
      "type": "number",
      "minimum": 0
    },
    "keys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/key"
      }
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scanCode",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "scanCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "extended": {
          "type": "boolean",
          "default": false
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
