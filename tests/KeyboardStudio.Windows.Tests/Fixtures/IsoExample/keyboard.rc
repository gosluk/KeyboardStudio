#include <windows.h>

1 VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_DRV_KEYBOARD
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "KeyboardStudio\0"
            VALUE "FileDescription", "ISO Example\0"
            VALUE "FileVersion", "2.0.0.0\0"
            VALUE "InternalName", "kbd-iso\0"
            VALUE "OriginalFilename", "kbd-iso.dll\0"
            VALUE "ProductName", "KeyboardStudio Keyboard Layout\0"
            VALUE "ProductVersion", "2.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
