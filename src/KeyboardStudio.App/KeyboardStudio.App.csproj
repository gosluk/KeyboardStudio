<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>KeyboardStudio</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <ApplicationIcon>Assets/KeyboardStudio.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/KeyboardStudio.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KeyboardStudio.Core\KeyboardStudio.Core.csproj" />
    <ProjectReference Include="..\KeyboardStudio.Persistence\KeyboardStudio.Persistence.csproj" />
    <ProjectReference Include="..\KeyboardStudio.Build\KeyboardStudio.Build.csproj" />
    <ProjectReference Include="..\KeyboardStudio.Linux\KeyboardStudio.Linux.csproj" />
  </ItemGroup>
</Project>
