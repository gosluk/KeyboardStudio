<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KeyboardStudio.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://KeyboardStudio/Styles/ThemeResources.axaml" />
        <ResourceInclude Source="avares://KeyboardStudio/Styles/IconResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Fluent supplies the control resources KeyboardStudio does not define. Each KeyboardStudio
         variant inherits Fluent Light or Dark, so an unstyled corner of a control degrades to a
         readable colour rather than to nothing. -->
    <FluentTheme />
    <StyleInclude Source="avares://KeyboardStudio/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
