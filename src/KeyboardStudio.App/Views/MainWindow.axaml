<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KeyboardStudio.App.Controls"
        x:Class="KeyboardStudio.App.MainWindow"
        Title="{Binding WindowTitle}"
        Width="1400"
        Height="820"
        MinWidth="980"
        MinHeight="600">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Command="{Binding NewCommand}" />
        <MenuItem Header="_Open…" Command="{Binding OpenCommand}" />
        <Separator />
        <MenuItem Header="_Import layout…" Command="{Binding ImportLayoutCommand}" />
        <MenuItem Header="Import _from file…" Command="{Binding ImportFromFileCommand}" />
        <Separator />
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" />
        <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" />
      </MenuItem>
    </Menu>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,360" Margin="10,6,10,10" ColumnSpacing="8" RowSpacing="6">
      <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="app-title" Text="KeyboardStudio" />
        <TextBlock Classes="muted" Text="{Binding DocumentStatus}" FontSize="12" />
        <Border VerticalAlignment="Center"
                Padding="7,1"
                CornerRadius="9"
                Background="#1FB45309"
                IsVisible="{Binding IsDirty}">
          <TextBlock Text="Unsaved changes"
                     FontSize="11"
                     Foreground="{DynamicResource WarningForegroundBrush}" />
        </Border>
        <TextBlock Classes="muted"
                   Text="{Binding ImportStatus}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   FontSize="12"
                   IsVisible="{Binding HasImportStatus}" />
      </StackPanel>

      <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">
        <Border Classes="card" VerticalAlignment="Top">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="section-title" Text="Keyboard" />
                <Border VerticalAlignment="Center"
                        Padding="7,1"
                        CornerRadius="9"
                        Background="{DynamicResource BadgeBackgroundBrush}">
                  <TextBlock Text="{Binding Editor.TemplateName}"
                             FontSize="11"
                             Foreground="{DynamicResource MutedForegroundBrush}" />
                </Border>
              </StackPanel>

              <!-- Wraps to a second line instead of clipping once the window is narrow. -->
              <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,14,2">
                  <TextBlock Classes="field-label" Text="Layer" />
                  <ComboBox ItemsSource="{Binding Editor.Layers}"
                            SelectedItem="{Binding Editor.ActiveLayerOption}"
                            Width="130">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="muted"
                             Text="{Binding Editor.LayerSummary}"
                             FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,2">
                  <TextBlock Classes="field-label" Text="New from" />
                  <ComboBox ItemsSource="{Binding Templates}"
                            SelectedItem="{Binding SelectedTemplate}"
                            Width="140">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="Create"
                          Command="{Binding NewCommand}"
                          ToolTip.Tip="Replace the current project with a new one built from the selected template" />
                  <Button Content="Import…"
                          Command="{Binding ImportLayoutCommand}"
                          ToolTip.Tip="Start from a layout this host already has installed" />
                </StackPanel>
              </WrapPanel>
            </Grid>

            <Border Grid.Row="1"
                    Padding="9"
                    Background="{DynamicResource KeyboardBezelBrush}"
                    BorderBrush="{DynamicResource KeyboardBezelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">
              <Viewbox Stretch="Uniform" StretchDirection="Both">
                <ItemsControl ItemsSource="{Binding Editor.Keys}"
                              Width="{Binding Editor.KeyboardWidth}"
                              Height="{Binding Editor.KeyboardHeight}"
                              UseLayoutRounding="False"
                              RenderOptions.EdgeMode="Antialias">
                  <ItemsControl.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding Left}" />
                      <Setter Property="Canvas.Top" Value="{Binding Top}" />
                    </ControlTheme>
                  </ItemsControl.ItemContainerTheme>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <controls:KeyControl KeyId="{Binding KeyId}"
                                           Label="{Binding Label}"
                                           Hint="{Binding Hint}"
                                           ShowHint="{Binding HasHint}"
                                           IsSelected="{Binding IsSelected}"
                                           IsUnmapped="{Binding IsUnmapped}"
                                           HasError="{Binding HasError}"
                                           SelectCommand="{Binding SelectCommand}"
                                           Width="{Binding Width}"
                                           Height="{Binding Height}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Viewbox>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card">
          <Grid RowDefinitions="Auto,*" RowSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="section-title" Text="Diagnostics" />
              <TextBlock Classes="muted" Text="{Binding Diagnostics.Summary}" FontSize="12" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Diagnostics.Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding SelectCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="8,4"
                            Margin="0,1">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="7">
                        <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Code}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                        <TextBlock Grid.Column="3"
                                   Classes="muted"
                                   Text="{Binding KeyAssociation}"
                                   FontSize="11" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Spacing="8">
          <Border Classes="card">
            <StackPanel Spacing="5">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                <TextBlock Classes="section-title" Text="Selected key" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Editor.SelectedKey.KeyId}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2"
                           Classes="muted mono"
                           Text="{Binding Editor.SelectedKey.ScanCode}" />
              </Grid>
              <Grid ColumnDefinitions="96,*" ColumnSpacing="6">
                <TextBlock Classes="field-label" Text="Logical key" />
                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Editor.LogicalKeys}"
                          SelectedItem="{Binding Editor.SelectedLogicalKey}" />
              </Grid>
              <TextBlock Text="Layer outputs" Margin="0,3,0,0" FontWeight="SemiBold" FontSize="12" />
              <ItemsControl ItemsSource="{Binding Editor.LayerMappings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="96,*,Auto" ColumnSpacing="6" Margin="0,1">
                      <TextBlock Classes="field-label" Text="{Binding Label}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Output, Mode=TwoWay}"
                               PlaceholderText="No output" />
                      <Button Grid.Column="2"
                              Content="Clear"
                              Command="{Binding ClearCommand}" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding ValidationMessage}"
                                 Foreground="{DynamicResource DangerForegroundBrush}"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasValidationError}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                <Button Content="Clear all outputs" Command="{Binding Editor.ClearAllOutputsCommand}" />
                <Button Content="Unmap logical key" Command="{Binding Editor.UnmapLogicalKeyCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="section-title" Text="Build" />
                <!-- With a single visible target there is nothing to choose, so the target name
                     shows as a badge and the selector below is collapsed. -->
                <Border VerticalAlignment="Center"
                        Padding="7,1"
                        CornerRadius="9"
                        Background="{DynamicResource BadgeBackgroundBrush}"
                        IsVisible="{Binding !Build.IsTargetSelectorVisible}">
                  <TextBlock Text="{Binding Build.SelectedTarget.DisplayName}"
                             FontSize="11"
                             Foreground="{DynamicResource MutedForegroundBrush}" />
                </Border>
              </StackPanel>
              <Grid ColumnDefinitions="96,*"
                    ColumnSpacing="6"
                    IsVisible="{Binding Build.IsTargetSelectorVisible}">
                <TextBlock Classes="field-label" Text="Target" />
                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Build.Targets}"
                          SelectedItem="{Binding Build.SelectedTarget}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="5">
                <TextBlock Classes="field-label" Text="Tools" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Build.EnvironmentStatus}"
                           TextWrapping="Wrap"
                           FontSize="12" />
                <TextBlock Grid.Row="1" Classes="field-label" Text="Validation" VerticalAlignment="Top" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Build.ValidationStatus}"
                           TextWrapping="Wrap"
                           FontSize="12" />
                <TextBlock Grid.Row="2" Classes="field-label" Text="Output" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Build.OutputDirectory, Mode=TwoWay}" />
                <TextBlock Grid.Row="3" Classes="field-label" Text="Profile" VerticalAlignment="Top" Margin="0,3,0,0" />
                <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Build.ProfileSettings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="88,*" ColumnSpacing="6" Margin="0,1">
                        <TextBlock Classes="field-label" Text="{Binding Label}" FontSize="12" />
                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Build" Command="{Binding Build.BuildCommand}" />
                <Button Content="Cancel" Command="{Binding Build.CancelBuildCommand}" />
                <TextBlock Classes="muted" Text="{Binding Build.Status}" TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Build.Stages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,1">
                      <TextBlock Text="{Binding Name}" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold" FontSize="12" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Build.Problems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8,6"
                            Margin="0,1"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource DangerForegroundBrush}"
                            CornerRadius="5">
                      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding Category}" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                          <TextBlock Text="{Binding Severity}" FontSize="12" />
                          <TextBlock Classes="mono" Text="{Binding Code}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="mono"
                         Text="{Binding Build.ArtifactPath}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Build.HasArtifact}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Build.GeneratedFiles}"
                          SelectedItem="{Binding Build.SelectedGeneratedFile}"
                          PlaceholderText="Generated source">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1"
                        Content="Inspect"
                        Command="{Binding Build.InspectGeneratedFileCommand}" />
              </Grid>
              <WrapPanel Orientation="Horizontal">
                <Button Content="Open output"
                        Margin="0,0,6,3"
                        Command="{Binding Build.OpenOutputDirectoryCommand}" />
                <Button Content="Copy build log"
                        Margin="0,0,6,3"
                        Command="{Binding Build.CopyBuildLogCommand}" />
                <Button Content="Copy artifact path"
                        Margin="0,0,0,3"
                        Command="{Binding Build.CopyArtifactPathCommand}" />
              </WrapPanel>
              <TextBlock Classes="muted"
                         Text="{Binding Build.ActionStatus}"
                         TextWrapping="Wrap"
                         FontSize="12" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
