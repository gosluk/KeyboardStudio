<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KeyboardStudio.App.Controls"
        x:Class="KeyboardStudio.App.MainWindow"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="2*,*" Margin="16">
    <Menu Grid.ColumnSpan="2" Margin="-8,-8,-8,10">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Command="{Binding NewCommand}" />
        <MenuItem Header="_Open…" Command="{Binding OpenCommand}" />
        <Separator />
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" />
        <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" />
      </MenuItem>
    </Menu>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
      <TextBlock Text="KeyboardStudio" FontSize="24" FontWeight="Bold" />
      <TextBlock Text="{Binding DocumentStatus}" VerticalAlignment="Center" Opacity="0.7" />
      <TextBlock Text="Unsaved changes"
                 VerticalAlignment="Center"
                 Foreground="#D97706"
                 IsVisible="{Binding IsDirty}" />
    </StackPanel>

    <Border Grid.Row="2" Grid.Column="0" Padding="16" Margin="0,0,12,0" BorderThickness="1" BorderBrush="#707070" CornerRadius="6">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <TextBlock Text="Keyboard" FontSize="18" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
          <TextBlock Text="Template for new project" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Templates}"
                    SelectedItem="{Binding SelectedTemplate}"
                    Width="220">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{Binding Editor.Layers}"
                    SelectedItem="{Binding Editor.ActiveLayerOption}"
                    Width="180">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <Border Grid.Row="2"
                Padding="8"
                Background="#18000000"
                CornerRadius="4"
                ClipToBounds="True">
          <Viewbox Stretch="Uniform" StretchDirection="Both">
            <ItemsControl ItemsSource="{Binding Editor.Keys}"
                          Width="{Binding Editor.KeyboardWidth}"
                          Height="{Binding Editor.KeyboardHeight}">
              <ItemsControl.ItemContainerTheme>
                <ControlTheme TargetType="ContentPresenter">
                  <Setter Property="Canvas.Left" Value="{Binding Left}" />
                  <Setter Property="Canvas.Top" Value="{Binding Top}" />
                </ControlTheme>
              </ItemsControl.ItemContainerTheme>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas ClipToBounds="True" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <controls:KeyControl KeyId="{Binding KeyId}"
                                       Label="{Binding Label}"
                                       Hint="{Binding Hint}"
                                       ShowHint="True"
                                       IsSelected="{Binding IsSelected}"
                                       IsUnmapped="{Binding IsUnmapped}"
                                       HasError="{Binding HasError}"
                                       SelectCommand="{Binding SelectCommand}"
                                       Width="{Binding Width}"
                                       Height="{Binding Height}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Viewbox>
        </Border>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="12">
      <Border Padding="16" BorderThickness="1" BorderBrush="#707070" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Text="Selected key" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Editor.SelectedKey.KeyId}" />
          <TextBlock Text="{Binding Editor.SelectedKey.ScanCode}" Opacity="0.7" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Logical key" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Editor.LogicalKeys}"
                      SelectedItem="{Binding Editor.SelectedLogicalKey}" />
          </Grid>
          <TextBlock Text="Layer outputs" Margin="0,8,0,0" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Editor.LayerMappings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="110,*,Auto" ColumnSpacing="8" Margin="0,2">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding Output, Mode=TwoWay}"
                           PlaceholderText="No output" />
                  <Button Grid.Column="2"
                          Content="Clear"
                          Command="{Binding ClearCommand}" />
                  <TextBlock Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding ValidationMessage}"
                             Foreground="#D32F2F"
                             FontSize="11"
                             TextWrapping="Wrap"
                             IsVisible="{Binding HasValidationError}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Content="Clear all outputs" Command="{Binding Editor.ClearAllOutputsCommand}" />
            <Button Content="Unmap logical key" Command="{Binding Editor.UnmapLogicalKeyCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Padding="16" BorderThickness="1" BorderBrush="#707070" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Text="Windows build" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Build.Status}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</Window>
