<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KeyboardStudio.App.Controls"
        x:Class="KeyboardStudio.App.MainWindow"
        Title="{Binding WindowTitle}"
        Width="1400"
        Height="820"
        MinWidth="980"
        MinHeight="600">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,360" Margin="10,8,10,10" ColumnSpacing="8" RowSpacing="8">
      <!-- One header row: identity, the document menu, what is open, and appearance. The standalone
           menu bar is gone; its commands live behind the File trigger beside the title. -->
      <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8" TabIndex="0">
        <TextBlock Classes="app-title" Text="KeyboardStudio" />

        <Button Grid.Column="1"
                Classes="quiet icon"
                AutomationProperties.Name="File"
                ToolTip.Tip="File menu">
          <PathIcon Data="{StaticResource FileIconGeometry}" Width="15" Height="15" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="_New" Command="{Binding NewCommand}" InputGesture="Ctrl+N" />
              <!-- Ctrl+N keeps the geometry already open; these are how a different one is asked
                   for, now that changing geometry no longer replaces the document by itself. -->
              <MenuItem Header="New _geometry" ItemsSource="{Binding NewDocumentOptions}">
                <MenuItem.ItemContainerTheme>
                  <!-- BasedOn is not optional: a ControlTheme replaces the whole theme, and the
                       one it replaces is where a MenuItem's template comes from. Without it the
                       items are built, bound, and drawn at zero size — an empty submenu. -->
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding Name}" />
                    <Setter Property="Command" Value="{Binding Command}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                  </ControlTheme>
                </MenuItem.ItemContainerTheme>
              </MenuItem>
              <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
              <Separator />
              <MenuItem Header="_Import layout…" Command="{Binding ImportLayoutCommand}" />
              <MenuItem Header="Import _from file…" Command="{Binding ImportFromFileCommand}" />
              <Separator />
              <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
              <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- The label stays short; the whole path is one hover away rather than the width of the
             header. -->
        <TextBlock Grid.Column="2"
                   Classes="muted"
                   Text="{Binding DocumentStatus}"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="320"
                   ToolTip.Tip="{Binding DocumentPath}" />

        <Border Grid.Column="3" Classes="badge warning" IsVisible="{Binding IsDirty}">
          <TextBlock Text="Unsaved changes" />
        </Border>

        <TextBlock Grid.Column="4"
                   Classes="muted"
                   Text="{Binding ImportStatus}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding HasImportStatus}" />

        <Button Grid.Column="5"
                Classes="quiet icon"
                AutomationProperties.Name="Appearance"
                ToolTip.Tip="Appearance">
          <PathIcon Data="{StaticResource AppearanceIconGeometry}" Width="15" Height="15" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="6" MinWidth="200">
                <TextBlock Classes="section-title" Text="Appearance" />
                <ItemsControl ItemsSource="{Binding Appearance.Options}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <RadioButton GroupName="ApplicationTheme"
                                   IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                   AutomationProperties.Name="{Binding Name}">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Classes="muted" Text="{Binding Description}" />
                        </StackPanel>
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="warning"
                           Text="{Binding Appearance.Warning}"
                           TextWrapping="Wrap"
                           MaxWidth="240"
                           IsVisible="{Binding Appearance.HasWarning}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <!-- The keyboard takes the room; diagnostics take what they need and no more. -->
      <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="8" TabIndex="1">
        <!-- Top-aligned in a star row: the keyboard is as large as its own aspect ratio allows and
             no larger, and gives way rather than pushing diagnostics off a short window. -->
        <Border Classes="card" VerticalAlignment="Top">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="section-title" Text="Keyboard" />
                <Border Classes="badge">
                  <TextBlock Text="{Binding Editor.TemplateName}" />
                </Border>
              </StackPanel>

              <!-- Wraps to a second line instead of clipping once the window is narrow. -->
              <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,2">
                  <TextBlock Classes="field-label" Text="Layer" />
                  <ComboBox ItemsSource="{Binding Editor.Layers}"
                            SelectedItem="{Binding Editor.ActiveLayerOption}"
                            Width="130">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="muted"
                             Text="{Binding Editor.LayerSummary}"
                             FontSize="12" />
                </StackPanel>
              </WrapPanel>
            </Grid>

            <Border Grid.Row="1" Classes="bezel">
              <Viewbox Stretch="Uniform" StretchDirection="Both">
                <ItemsControl ItemsSource="{Binding Editor.Keys}"
                              Width="{Binding Editor.KeyboardWidth}"
                              Height="{Binding Editor.KeyboardHeight}"
                              UseLayoutRounding="False"
                              RenderOptions.EdgeMode="Antialias">
                  <ItemsControl.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding Left}" />
                      <Setter Property="Canvas.Top" Value="{Binding Top}" />
                    </ControlTheme>
                  </ItemsControl.ItemContainerTheme>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <controls:KeyControl KeyId="{Binding KeyId}"
                                           KeyName="{Binding KeyName}"
                                           DefaultAssignment="{Binding DefaultAssignment}"
                                           ShiftAssignment="{Binding ShiftAssignment}"
                                           AltGrAssignment="{Binding AltGrAssignment}"
                                           ShiftAltGrAssignment="{Binding ShiftAltGrAssignment}"
                                           IsDefaultActive="{Binding IsDefaultActive}"
                                           IsShiftActive="{Binding IsShiftActive}"
                                           IsAltGrActive="{Binding IsAltGrActive}"
                                           IsShiftAltGrActive="{Binding IsShiftAltGrActive}"
                                           IsSelected="{Binding IsSelected}"
                                           IsUnmapped="{Binding IsUnmapped}"
                                           HasError="{Binding HasError}"
                                           SelectCommand="{Binding SelectCommand}"
                                           Width="{Binding Width}"
                                           Height="{Binding Height}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Viewbox>
            </Border>
          </Grid>
        </Border>

        <!-- A clean document is the normal case, so this collapses to one line and gives the room
             back to the keyboard. It opens itself when an error appears. -->
        <Border Grid.Row="1" Classes="card subtle" Padding="4,2" TabIndex="3">
          <Expander Classes="flat"
                    HorizontalAlignment="Stretch"
                    IsExpanded="{Binding Diagnostics.IsExpanded, Mode=TwoWay}"
                    IsEnabled="{Binding Diagnostics.HasIssues}"
                    AutomationProperties.Name="Diagnostics">
            <Expander.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="section-title" Text="Diagnostics" />
                <TextBlock Classes="muted" Text="{Binding Diagnostics.Summary}" />
              </StackPanel>
            </Expander.Header>
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Diagnostics.Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="quiet"
                            Command="{Binding SelectCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="8,5"
                            Margin="0,1">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="7">
                        <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Code}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                        <TextBlock Grid.Column="3"
                                   Classes="muted"
                                   Text="{Binding KeyAssociation}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Expander>
        </Border>
      </Grid>

      <ScrollViewer Grid.Row="1"
                    Grid.Column="1"
                    TabIndex="2"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0">
        <StackPanel Spacing="8">
          <Border Classes="card subtle">
            <StackPanel Spacing="5">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                <TextBlock Classes="section-title" Text="Selected key" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Editor.SelectedKey.KeyId}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2"
                           Classes="muted mono"
                           Text="{Binding Editor.SelectedKey.ScanCode}" />
              </Grid>
              <Grid ColumnDefinitions="96,*" ColumnSpacing="6">
                <TextBlock Classes="field-label" Text="Logical key" />
                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Editor.LogicalKeys}"
                          SelectedItem="{Binding Editor.SelectedLogicalKey}" />
              </Grid>
              <TextBlock Text="Layer outputs" Margin="0,3,0,0" FontWeight="SemiBold" FontSize="12" />
              <ItemsControl ItemsSource="{Binding Editor.LayerMappings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="96,*,Auto" ColumnSpacing="6" Margin="0,1">
                      <TextBlock Classes="field-label" Text="{Binding Label}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Output, Mode=TwoWay}"
                               PlaceholderText="No output" />
                      <Button Grid.Column="2"
                              Classes="quiet"
                              Content="Clear"
                              Command="{Binding ClearCommand}" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="1"
                                 Classes="danger"
                                 Text="{Binding ValidationMessage}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasValidationError}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                <Button Classes="quiet" Content="Clear all outputs" Command="{Binding Editor.ClearAllOutputsCommand}" />
                <Button Classes="quiet" Content="Unmap logical key" Command="{Binding Editor.UnmapLogicalKeyCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card subtle">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="section-title" Text="Build" />
                <!-- With a single visible target there is nothing to choose, so the target name
                     shows as a badge and the selector below is collapsed. -->
                <Border Classes="badge" IsVisible="{Binding !Build.IsTargetSelectorVisible}">
                  <TextBlock Text="{Binding Build.SelectedTarget.DisplayName}" />
                </Border>
              </StackPanel>
              <Grid ColumnDefinitions="96,*"
                    ColumnSpacing="6"
                    IsVisible="{Binding Build.IsTargetSelectorVisible}">
                <TextBlock Classes="field-label" Text="Target" />
                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Build.Targets}"
                          SelectedItem="{Binding Build.SelectedTarget}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="5">
                <TextBlock Classes="field-label" Text="Tools" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Build.EnvironmentStatus}"
                           TextWrapping="Wrap"
                           FontSize="12" />
                <TextBlock Grid.Row="1" Classes="field-label" Text="Validation" VerticalAlignment="Top" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Build.ValidationStatus}"
                           TextWrapping="Wrap"
                           FontSize="12" />
                <TextBlock Grid.Row="2" Classes="field-label" Text="Output" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Build.OutputDirectory, Mode=TwoWay}" />
                <TextBlock Grid.Row="3" Classes="field-label" Text="Profile" VerticalAlignment="Top" Margin="0,3,0,0" />
                <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Build.ProfileSettings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="88,*"
                            ColumnSpacing="6"
                            Margin="0,1"
                            IsVisible="{Binding IsVisible}">
                        <TextBlock Classes="field-label" Text="{Binding Label}" FontSize="12" />
                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="primary" Content="Build" Command="{Binding Build.BuildCommand}" />
                <Button Content="Cancel" Command="{Binding Build.CancelBuildCommand}" />
                <TextBlock Classes="muted" Text="{Binding Build.Status}" TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Build.Stages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,1">
                      <TextBlock Text="{Binding Name}" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold" FontSize="12" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Build.Problems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="problem" Margin="0,1">
                      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding Category}" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                          <TextBlock Text="{Binding Severity}" FontSize="12" />
                          <TextBlock Classes="mono" Text="{Binding Code}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="mono"
                         Text="{Binding Build.ArtifactPath}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Build.HasArtifact}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Build.GeneratedFiles}"
                          SelectedItem="{Binding Build.SelectedGeneratedFile}"
                          PlaceholderText="Generated source">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1"
                        Classes="quiet"
                        Content="Inspect"
                        Command="{Binding Build.InspectGeneratedFileCommand}" />
              </Grid>
              <WrapPanel Orientation="Horizontal">
                <Button Classes="quiet"
                        Content="Open output"
                        Margin="0,0,6,3"
                        Command="{Binding Build.OpenOutputDirectoryCommand}" />
                <Button Classes="quiet"
                        Content="Copy build log"
                        Margin="0,0,6,3"
                        Command="{Binding Build.CopyBuildLogCommand}" />
                <Button Classes="quiet"
                        Content="Copy artifact path"
                        Margin="0,0,0,3"
                        Command="{Binding Build.CopyArtifactPathCommand}" />
              </WrapPanel>
              <TextBlock Classes="muted"
                         Text="{Binding Build.ActionStatus}"
                         TextWrapping="Wrap"
                         FontSize="12" />
            </StackPanel>
          </Border>

          <Border Classes="card subtle" IsVisible="{Binding LinuxVariant.IsVisible}">
            <StackPanel Spacing="7">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBlock Classes="section-title" Text="Linux user variant" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LinuxVariant.Status}"
                           FontSize="12"
                           FontWeight="SemiBold" />
              </Grid>

              <TextBlock Text="Augments the imported system layout in your user XKB directory. It never edits /usr/share or activates a layout."
                         Classes="muted"
                         TextWrapping="Wrap"
                         FontSize="12" />

              <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                <TextBlock Classes="field-label" Text="Base" />
                <TextBlock Grid.Column="1">
                  <Run Text="{Binding LinuxVariant.BaseLayout}" />
                  <Run Text=" (" />
                  <Run Text="{Binding LinuxVariant.BaseVariant}" />
                  <Run Text=")" />
                </TextBlock>
                <TextBlock Grid.Row="1" Classes="field-label" Text="Import fidelity" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LinuxVariant.SourceFidelity}" />
                <TextBlock Grid.Row="2" Classes="field-label" Text="Variant ID" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding LinuxVariant.VariantId, Mode=TwoWay}"
                         IsReadOnly="{Binding !LinuxVariant.CanEditVariantId}"
                         PlaceholderText="keyboardstudio_programmer" />
              </Grid>

              <Grid ColumnDefinitions="96,*" ColumnSpacing="6">
                <TextBlock Classes="field-label" Text="Display name" />
                <TextBox Grid.Column="1"
                         Text="{Binding LinuxVariant.DisplayName, Mode=TwoWay}"
                         PlaceholderText="Polish - KeyboardStudio" />
              </Grid>

              <TextBlock Text="{Binding LinuxVariant.StatusText}"
                         TextWrapping="Wrap"
                         FontSize="12" />
              <TextBlock Text="{Binding LinuxVariant.CapabilityText}"
                         Classes="muted"
                         TextWrapping="Wrap"
                         FontSize="12" />
              <TextBlock Text="{Binding LinuxVariant.PathsText}"
                         Classes="mono"
                         TextWrapping="Wrap"
                         FontSize="12" />
              <TextBlock Classes="warning"
                         Text="{Binding LinuxVariant.DiagnosticsText}"
                         TextWrapping="Wrap"
                         FontSize="12"
                         IsVisible="{Binding LinuxVariant.HasDiagnostics}" />

              <WrapPanel Orientation="Horizontal">
                <Button Classes="quiet"
                        Content="Refresh"
                        Margin="0,0,6,4"
                        Command="{Binding LinuxVariant.RefreshCommand}" />
                <Button Content="Generate bundle"
                        Margin="0,0,6,4"
                        Command="{Binding LinuxVariant.GenerateCommand}" />
                <Button Classes="primary"
                        Content="Install"
                        Margin="0,0,6,4"
                        Command="{Binding LinuxVariant.InstallCommand}" />
                <Button Content="Update"
                        Margin="0,0,6,4"
                        Command="{Binding LinuxVariant.UpdateCommand}" />
                <Button Classes="quiet"
                        Content="Verify installed"
                        Margin="0,0,6,4"
                        Command="{Binding LinuxVariant.VerifyInstalledCommand}" />
                <Button Classes="destructive"
                        Content="Uninstall"
                        Margin="0,0,6,4"
                        Command="{Binding LinuxVariant.UninstallCommand}" />
                <Button Content="Cancel"
                        Margin="0,0,6,4"
                        Command="{Binding LinuxVariant.CancelCommand}" />
                <Button Classes="quiet"
                        Content="Open bundle"
                        Margin="0,0,0,4"
                        Command="{Binding LinuxVariant.OpenOutputCommand}" />
              </WrapPanel>
              <TextBlock Text="{Binding LinuxVariant.GeneratedBundlePath}"
                         Classes="mono"
                         TextWrapping="Wrap"
                         FontSize="12"
                         IsVisible="{Binding LinuxVariant.HasGeneratedBundle}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
