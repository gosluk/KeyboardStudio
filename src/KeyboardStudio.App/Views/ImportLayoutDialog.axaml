<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KeyboardStudio.App.Controls"
        x:Class="KeyboardStudio.App.ImportLayoutDialog"
        Title="{Binding Title}"
        Width="1080"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="10">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
      <TextBlock Classes="muted"
                 Text="{Binding Status}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 FontSize="12" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" Click="CancelClicked" />
        <Button Content="Import" Click="ImportClicked" IsEnabled="{Binding CanAccept}" />
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="320,*" ColumnSpacing="8">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
          <TextBlock Classes="section-title" Text="Available layouts" />
          <TextBox Grid.Row="1"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="Search by name, code or language"
                   IsVisible="{Binding IsSearchable}" />
          <ListBox Grid.Row="2"
                   ItemsSource="{Binding Layouts}"
                   SelectedItem="{Binding SelectedLayout, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="1" Margin="0,2">
                  <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                  <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="11" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2"
                     Classes="muted"
                     Text="No layouts match."
                     TextWrapping="Wrap"
                     Margin="4,6"
                     VerticalAlignment="Top"
                     IsVisible="{Binding !HasLayouts}" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Spacing="8">
          <Border Classes="card">
            <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="6">
              <TextBlock Classes="field-label" Text="Variant" />
              <ComboBox Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Variants}"
                        SelectedItem="{Binding SelectedVariant, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="1" Classes="field-label" Text="Geometry" VerticalAlignment="Center" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{Binding Templates}"
                          SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                          IsEnabled="{Binding IsGeometrySelectable}"
                          Width="160">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <!-- The registry does not record physical geometry, so the suggestion is an
                     inference the user is free to overrule. -->
                <CheckBox Content="Use the suggested geometry"
                          IsChecked="{Binding UseSuggestedGeometry, Mode=TwoWay}"
                          IsEnabled="{Binding IsGeometrySelectable}" />
              </StackPanel>

              <TextBlock Grid.Row="2" Classes="field-label" Text="Commit as" VerticalAlignment="Center" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="14">
                <RadioButton GroupName="CommitMode"
                             Content="A new project"
                             IsChecked="{Binding CommitAsNewProject, Mode=TwoWay}" />
                <RadioButton GroupName="CommitMode"
                             Content="Replacement mappings for the open project"
                             IsChecked="{Binding CommitAsMappingReplacement, Mode=TwoWay}"
                             IsEnabled="{Binding CanReplaceMappings}"
                             ToolTip.Tip="Keeps the open project's geometry, build settings and file" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="card">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="section-title" Text="Fidelity" />
                <Border VerticalAlignment="Center"
                        Padding="7,1"
                        CornerRadius="9"
                        Background="{DynamicResource BadgeBackgroundBrush}"
                        IsVisible="{Binding Report, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{Binding Report.FidelityLabel}"
                             FontSize="11"
                             Foreground="{DynamicResource MutedForegroundBrush}" />
                </Border>
                <TextBlock Classes="muted"
                           Text="{Binding Report.Summary}"
                           VerticalAlignment="Center"
                           FontSize="12" />
              </StackPanel>
              <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="{Binding Report.FidelityDescription}"
                           TextWrapping="Wrap"
                           FontSize="12" />
                <TextBlock Classes="muted mono"
                           Text="{Binding Report.IncludeChain}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           IsVisible="{Binding Report.HasIncludeChain, FallbackValue=False}" />
                <ItemsControl ItemsSource="{Binding Report.Diagnostics}" MaxHeight="180">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="7" Margin="0,1">
                        <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Code}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                        <TextBlock Grid.Column="3" Classes="muted" Text="{Binding KeyAssociation}" FontSize="11" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="card">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBlock Classes="section-title" Text="Preview" />
              <Border Grid.Row="1"
                      Padding="9"
                      MinHeight="180"
                      Background="{DynamicResource KeyboardBezelBrush}"
                      BorderBrush="{DynamicResource KeyboardBezelBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      ClipToBounds="True">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                  <ItemsControl ItemsSource="{Binding PreviewKeys}"
                                Width="{Binding PreviewWidth}"
                                Height="{Binding PreviewHeight}"
                                UseLayoutRounding="False"
                                RenderOptions.EdgeMode="Antialias">
                    <ItemsControl.ItemContainerTheme>
                      <ControlTheme TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                      </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <!-- No SelectCommand: the preview shows the layout, it does not edit it. -->
                        <controls:KeyControl KeyId="{Binding KeyId}"
                                             KeyName="{Binding KeyName}"
                                             DefaultAssignment="{Binding DefaultAssignment}"
                                             ShiftAssignment="{Binding ShiftAssignment}"
                                             AltGrAssignment="{Binding AltGrAssignment}"
                                             ShiftAltGrAssignment="{Binding ShiftAltGrAssignment}"
                                             IsDefaultActive="{Binding IsDefaultActive}"
                                             IsShiftActive="{Binding IsShiftActive}"
                                             IsAltGrActive="{Binding IsAltGrActive}"
                                             IsShiftAltGrActive="{Binding IsShiftAltGrActive}"
                                             IsUnmapped="{Binding IsUnmapped}"
                                             Width="{Binding Width}"
                                             Height="{Binding Height}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Viewbox>
              </Border>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
