<!--
  Structure and state for KeyboardStudio's own surfaces. Colour lives in ThemeResources.axaml and
  reaches this file only through DynamicResource, so a palette change never edits a style and a
  style never pins a colour.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!--
      KeyboardStudio owns its button surface rather than tinting Fluent's. Fluent applies its hover
      and pressed colours to named parts inside its own template, which cannot be redirected to a
      token without depending on those names; owning the template makes every state a token and
      leaves nothing for an Avalonia upgrade to change underneath the palette.
    -->
    <ControlTheme x:Key="AppButtonTheme" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransform" Value="translateY(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.11" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.11" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
        </Transitions>
      </Setter>
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border BorderBrush="{DynamicResource FocusBorderBrush}"
                  BorderThickness="2"
                  CornerRadius="7"
                  Margin="-2" />
        </FocusAdornerTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="{DynamicResource ButtonBoxShadow}">
            <Grid>
              <!-- A restrained top glint gives every solid or gradient button surface the same
                   machined edge without baking palette colours into the template. -->
              <Border Name="PART_Highlight"
                      Height="1"
                      Margin="4,1,4,0"
                      VerticalAlignment="Top"
                      Background="{DynamicResource ButtonHighlightBrush}"
                      CornerRadius="4"
                      IsHitTestVisible="False" />
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource ButtonHoverSurfaceBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonPressedSurfaceBrush}" />
        <Setter Property="RenderTransform" Value="translateY(1px)" />
      </Style>

      <!-- Primary: the one action a surface is asking for. Build and explicit commits, nothing else. -->
      <Style Selector="^.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style Selector="^.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
      </Style>
      <Style Selector="^.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
      </Style>

      <!-- Quiet: utility actions that should not compete with the work surface. -->
      <Style Selector="^.quiet">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
      </Style>
      <Style Selector="^.quiet /template/ Border#PART_Surface">
        <Setter Property="BoxShadow" Value="none" />
      </Style>
      <Style Selector="^.quiet /template/ Border#PART_Highlight">
        <Setter Property="Opacity" Value="0" />
      </Style>
      <Style Selector="^.quiet:pointerover">
        <Setter Property="Background" Value="{DynamicResource QuietButtonHoverSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
      </Style>
      <Style Selector="^.quiet:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonPressedSurfaceBrush}" />
      </Style>

      <!-- Destructive: reads as danger before it is pressed, not after. -->
      <Style Selector="^.destructive">
        <Setter Property="Background" Value="{DynamicResource DestructiveButtonSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DestructiveButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DestructiveButtonForegroundBrush}" />
      </Style>
      <Style Selector="^.destructive:pointerover">
        <Setter Property="Background" Value="{DynamicResource DestructiveButtonHoverSurfaceBrush}" />
      </Style>
      <Style Selector="^.destructive:pressed">
        <Setter Property="Background" Value="{DynamicResource DestructiveButtonPressedSurfaceBrush}" />
      </Style>

      <!-- Disabled last: no class may present an action that cannot be taken as available. -->
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource ButtonDisabledSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonDisabledBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
      </Style>
      <Style Selector="^:disabled /template/ Border#PART_Surface">
        <Setter Property="BoxShadow" Value="none" />
      </Style>
      <Style Selector="^.quiet:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
    </ControlTheme>

    <!-- Tooltips carry dense key and build information, so they own a real elevated surface
         instead of inheriting the platform theme's flat one-line presenter. -->
    <ControlTheme x:Key="AppToolTipTheme" TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource TooltipSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TooltipBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TooltipForegroundBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MaxWidth" Value="360" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  BoxShadow="{DynamicResource ElevatedBoxShadow}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
    <Setter Property="FontFamily" Value="Inter, $Default" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardBoxShadow}" />
  </Style>

  <Style Selector="Border.app-chrome">
    <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardBoxShadow}" />
  </Style>

  <Style Selector="Border.brand-mark">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BoxShadow" Value="{DynamicResource ButtonBoxShadow}" />
  </Style>

  <Style Selector="Border.brand-mark > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Supporting cards sit behind the keyboard in the hierarchy, so they carry no elevation. -->
  <Style Selector="Border.card.subtle">
    <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- An expander used as a section heading rather than as a control in its own right: the card
       around it already supplies the surface, so it supplies none. -->
  <Style Selector="Expander.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
  </Style>

  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.badge > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BadgeForegroundBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.badge.warning">
    <Setter Property="Background" Value="{DynamicResource DirtyBadgeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DirtyBadgeBorderBrush}" />
  </Style>

  <Style Selector="Border.badge.warning > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DirtyBadgeForegroundBrush}" />
  </Style>

  <!-- A finding that names a key is a place to go; one that names none is only a message. The
       cursor is what says which, before the click that would find out. -->
  <Style Selector="Button.diagnostic-row">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.diagnostic-row.actionable">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Border.problem">
    <Setter Property="Background" Value="{DynamicResource BuildProblemSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BuildProblemBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style Selector="Border.bezel">
    <Setter Property="Background" Value="{DynamicResource KeyboardBezelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KeyboardBezelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="BoxShadow" Value="{DynamicResource KeyboardBezelBoxShadow}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.keyboard-inner">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource KeyboardInnerBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="TextBlock.app-title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 12px is the floor for supporting text: below it the neutral palettes stop being legible
       before they stop being readable. -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.field-label">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
  </Style>

  <Style Selector="Button:not(.key-face)">
    <Setter Property="Theme" Value="{StaticResource AppButtonTheme}" />
  </Style>

  <!-- Icon triggers are square and sized for a pointer, not for their glyph. -->
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="6" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource InputForegroundBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectionSurfaceBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionForegroundBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.11" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.11" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TextBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource InputHoverSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
  </Style>

  <!-- Fluent paints TextBox states on its named border, so the semantic application palette must
       meet that part as well as the outer control property. -->
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource InputHoverSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
  </Style>

  <Style Selector="TextBox:focus, TextBox:focus-within">
    <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
  </Style>

  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
  </Style>

  <Style Selector="TextBox:disabled">
    <Setter Property="Background" Value="{DynamicResource InputDisabledSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.11" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.11" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ComboBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource InputHoverSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
  </Style>

  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource InputHoverSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
  </Style>

  <Style Selector="ComboBox:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ButtonPressedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
  </Style>

  <Style Selector="ComboBox:focus, ComboBox:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
  </Style>

  <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource MenuSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="{DynamicResource ElevatedBoxShadow}" />
  </Style>

  <Style Selector="ComboBox:disabled">
    <Setter Property="Background" Value="{DynamicResource InputDisabledSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style Selector="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
    <Setter Property="Padding" Value="4,1" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="MenuItem:pointerover, MenuItem:selected">
    <Setter Property="Background" Value="{DynamicResource MenuHoverSurfaceBrush}" />
  </Style>

  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot,
                   MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource MenuHoverSurfaceBrush}" />
  </Style>

  <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ButtonPressedSurfaceBrush}" />
  </Style>

  <Style Selector="MenuItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
  </Style>

  <Style Selector="FlyoutPresenter, MenuFlyoutPresenter, ContextMenu">
    <Setter Property="Background" Value="{DynamicResource MenuSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="5" />
  </Style>

  <Style Selector="MenuFlyoutPresenter /template/ Border#LayoutRoot">
    <Setter Property="BoxShadow" Value="{DynamicResource ElevatedBoxShadow}" />
  </Style>

  <Style Selector="ComboBoxItem, ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="9,5" />
  </Style>

  <Style Selector="ComboBoxItem:pointerover, ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource MenuHoverSurfaceBrush}" />
  </Style>

  <Style Selector="ComboBoxItem:selected, ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Theme" Value="{StaticResource AppToolTipTheme}" />
    <Setter Property="Background" Value="{DynamicResource TooltipSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TooltipBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TooltipForegroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="CheckBox, RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
</Styles>
