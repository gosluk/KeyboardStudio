<!--
  Application-owned vector icons, drawn on a 24x24 grid.

  These are geometries rather than images so they inherit the foreground of whatever presents them
  and stay sharp at every display scale. Phase 15 deliberately adds no icon package and no raster
  asset: one icon does not justify a dependency whose licence, size, and update cadence the project
  would then own.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A half-filled disc: the conventional mark for choosing light or dark, and readable at 16px
       where a palette or brush is not. -->
  <StreamGeometry x:Key="AppearanceIconGeometry">M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 Z M12,3 A9,9 0 0 1 12,21 Z</StreamGeometry>
</ResourceDictionary>
