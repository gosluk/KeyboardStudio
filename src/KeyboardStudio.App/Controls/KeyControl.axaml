<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KeyboardStudio.App.Controls.KeyControl"
             x:Name="Root"
             RenderOptions.EdgeMode="Antialias"
             TextOptions.TextRenderingMode="Antialias">
  <UserControl.Resources>
    <!-- The Fluent Button theme aligns itself to its content, which collapsed every key
         down to the width of its legend. The key face owns its whole cell instead. -->
    <ControlTheme x:Key="KeyFaceTheme" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource KeyFaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KeyBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource KeyLegendBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Face"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.key-assignment">
      <Setter Property="Foreground" Value="{DynamicResource KeyLegendBrush}" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.layer-slot">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Margin" Value="1" />
    </Style>
    <Style Selector="Border.layer-slot.active">
      <Setter Property="Background" Value="{DynamicResource KeyActiveLayerBrush}" />
    </Style>
    <Style Selector="Border.layer-slot.active TextBlock.key-assignment">
      <Setter Property="Foreground" Value="{DynamicResource KeyActiveLegendBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.key-name">
      <Setter Property="Foreground" Value="{DynamicResource KeyHintBrush}" />
      <Setter Property="FontSize" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.key-face:pointerover">
      <Setter Property="Background" Value="{DynamicResource KeyFaceHoverBrush}" />
    </Style>
    <Style Selector="Button.key-face:pressed">
      <Setter Property="Background" Value="{DynamicResource KeyFacePressedBrush}" />
    </Style>
    <Style Selector="Button.key-face.error, Button.key-face.error:pointerover">
      <Setter Property="Background" Value="{DynamicResource KeyErrorFaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KeyErrorBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.key-face.selected, Button.key-face.selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource KeySelectedFaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KeySelectedBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <Button Theme="{StaticResource KeyFaceTheme}"
          Classes="key-face"
          Classes.selected="{Binding IsSelected, ElementName=Root}"
          Classes.unmapped="{Binding IsUnmapped, ElementName=Root}"
          Classes.error="{Binding HasError, ElementName=Root}"
          Command="{Binding SelectCommand, ElementName=Root}">
    <ToolTip.Tip>
      <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
        <TextBlock Text="Default" Foreground="{DynamicResource KeyHintBrush}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding DefaultAssignment, ElementName=Root}"
                   TextWrapping="NoWrap"
                   TextTrimming="None" />

        <TextBlock Grid.Row="1" Text="Shift" Foreground="{DynamicResource KeyHintBrush}" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Text="{Binding ShiftAssignment, ElementName=Root}"
                   TextWrapping="NoWrap"
                   TextTrimming="None" />

        <TextBlock Grid.Row="2" Text="AltGr" Foreground="{DynamicResource KeyHintBrush}" />
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Text="{Binding AltGrAssignment, ElementName=Root}"
                   TextWrapping="NoWrap"
                   TextTrimming="None" />

        <TextBlock Grid.Row="3" Text="Shift + AltGr" Foreground="{DynamicResource KeyHintBrush}" />
        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   Text="{Binding ShiftAltGrAssignment, ElementName=Root}"
                   TextWrapping="NoWrap"
                   TextTrimming="None" />
      </Grid>
    </ToolTip.Tip>
    <Grid RowDefinitions="*,Auto">
      <!-- The positions mirror the supplied keycap: unshifted assignments are on top,
           shifted assignments below, and AltGr assignments occupy the right column. -->
      <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
        <Border Classes="layer-slot"
                Classes.active="{Binding IsDefaultActive, ElementName=Root}">
          <ToolTip.Tip>
            <TextBlock Text="{Binding DefaultAssignment, ElementName=Root}"
                       TextWrapping="NoWrap"
                       TextTrimming="None"
                       Margin="2,0" />
          </ToolTip.Tip>
          <TextBlock Classes="key-assignment"
                     Text="{Binding DefaultAssignment, ElementName=Root}" />
        </Border>
        <Border Grid.Column="1"
                Classes="layer-slot"
                Classes.active="{Binding IsAltGrActive, ElementName=Root}">
          <ToolTip.Tip>
            <TextBlock Text="{Binding AltGrAssignment, ElementName=Root}"
                       TextWrapping="NoWrap"
                       TextTrimming="None"
                       Margin="2,0" />
          </ToolTip.Tip>
          <TextBlock Classes="key-assignment"
                     Text="{Binding AltGrAssignment, ElementName=Root}" />
        </Border>
        <Border Grid.Row="1"
                Classes="layer-slot"
                Classes.active="{Binding IsShiftActive, ElementName=Root}">
          <ToolTip.Tip>
            <TextBlock Text="{Binding ShiftAssignment, ElementName=Root}"
                       TextWrapping="NoWrap"
                       TextTrimming="None"
                       Margin="2,0" />
          </ToolTip.Tip>
          <TextBlock Classes="key-assignment"
                     Text="{Binding ShiftAssignment, ElementName=Root}" />
        </Border>
        <Border Grid.Row="1"
                Grid.Column="1"
                Classes="layer-slot"
                Classes.active="{Binding IsShiftAltGrActive, ElementName=Root}">
          <ToolTip.Tip>
            <TextBlock Text="{Binding ShiftAltGrAssignment, ElementName=Root}"
                       TextWrapping="NoWrap"
                       TextTrimming="None"
                       Margin="2,0" />
          </ToolTip.Tip>
          <TextBlock Classes="key-assignment"
                     Text="{Binding ShiftAltGrAssignment, ElementName=Root}" />
        </Border>
      </Grid>
      <TextBlock Grid.Row="1"
                 Classes="key-name"
                 Text="{Binding KeyName, ElementName=Root}"
                 Margin="1,1,1,0" />
    </Grid>
  </Button>
</UserControl>
